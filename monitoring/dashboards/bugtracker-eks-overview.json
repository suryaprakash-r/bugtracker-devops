                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum by (pod) (kube_pod_container_status_restarts_total{namespace=\"webapps\"})",
                                           "legendFormat":  "{{pod}}"
                                       }
                                   ],
                       "options":  {
                                       "legend":  {
