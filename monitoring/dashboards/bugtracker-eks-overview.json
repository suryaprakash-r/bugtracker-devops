                    },
    "editable":  true,
    "graphTooltip":  0,
    "panels":  [
                   {
                       "id":  1,
                       "type":  "timeseries",
                       "title":  "EKS Node CPU Utilization",
                       "description":  "CPU utilization percentage for each worker node.",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${DS_PROMETHEUS}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  0
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "min":  0,
                                                            "max":  100
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])))",
                                           "legendFormat":  "{{instance}}"
                                       }
                                   ],
                       "options":  {
                                       "legend":  {
                                                      "showLegend":  true,
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "single"
                                                   }
                                   }
                   },
                   {
                       "id":  2,
                       "type":  "timeseries",
                       "title":  "EKS Node Memory Utilization",
                       "description":  "Memory utilization percentage for each worker node.",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${DS_PROMETHEUS}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  0
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "percent",
                                                            "min":  0,
                                                            "max":  100
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
                                           "legendFormat":  "{{instance}}"
                                       }
                                   ],
                       "options":  {
                                       "legend":  {
                                                      "showLegend":  true,
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "single"
                                                   }
                                   }
                   },
                   {
                       "id":  3,
                       "type":  "timeseries",
                       "title":  "BugTracker Pod CPU Usage",
                       "description":  "CPU consumption by containers in the webapps namespace.",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${DS_PROMETHEUS}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "cores"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"webapps\",container!=\"\",container!=\"POD\"}[5m]))",
                                           "legendFormat":  "{{pod}}"
                                       }
                                   ],
                       "options":  {
                                       "legend":  {
                                                      "showLegend":  true,
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "single"
                                                   }
                                   }
                   },
                   {
                       "id":  4,
                       "type":  "timeseries",
                       "title":  "BugTracker Pod Memory Usage",
                       "description":  "Working-set memory used by BugTracker containers.",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${DS_PROMETHEUS}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  12,
                                       "y":  8
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "bytes"
                                                        },
                                           "overrides":  [

                                                         ]
                                       },
                       "targets":  [
                                       {
                                           "refId":  "A",
                                           "expr":  "sum by (pod) (container_memory_working_set_bytes{namespace=\"webapps\",container!=\"\",container!=\"POD\"})",
                                           "legendFormat":  "{{pod}}"
                                       }
                                   ],
                       "options":  {
                                       "legend":  {
                                                      "showLegend":  true,
                                                      "displayMode":  "list",
                                                      "placement":  "bottom"
                                                  },
                                       "tooltip":  {
                                                       "mode":  "single"
                                                   }
                                   }
                   },
                   {
                       "id":  5,
                       "type":  "timeseries",
                       "title":  "BugTracker Container Restarts",
                       "description":  "Restart counters for containers in the webapps namespace.",
                       "datasource":  {
                                          "type":  "prometheus",
                                          "uid":  "${DS_PROMETHEUS}"
                                      },
                       "gridPos":  {
                                       "h":  8,
                                       "w":  12,
                                       "x":  0,
                                       "y":  16
                                   },
                       "fieldConfig":  {
                                           "defaults":  {
                                                            "unit":  "short",
